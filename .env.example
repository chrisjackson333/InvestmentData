# Ingestion domain (data-jobs/ingestion)
INGESTION_RAW_ZONE_ROOT=./.localstack_raw
INGESTION_SOURCE=csv
INGESTION_STRICT_VALIDATION=false

# Signal Engine domain (services/signal-engine)
SIGNAL_SMA_PERIOD=20

# API Layer domain (services/api-orchestrator)
API_HOST=0.0.0.0
API_PORT=8000
API_DEFAULT_SIGNALS_LIMIT=50
API_MAX_SIGNALS_LIMIT=500

# Database (services/signal-engine persistence layer)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investment_platform
DB_USER=investment_platform
DB_PASSWORD=investment_platform

# Streaming domain (services/streaming)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=investment-platform-streaming-consumer

# AWS - defined in a later increment
# AWS_...
